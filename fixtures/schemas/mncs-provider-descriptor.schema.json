{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/provider/0.1/descriptor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "name", "command", "timeout_seconds", "extensions"],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "name": {"type": "string", "minLength": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
    "extensions": {"type": "object"}
  }
}
