{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/0.1/mncs-provenance.schema.json",
  "title": "MNCS provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mncs_version",
    "generator",
    "generator_version",
    "generator_hash",
    "inputs",
    "command",
    "generated_at",
    "source_hash",
    "artifact_hash",
    "evaluator",
    "evaluator_version",
    "evaluator_hash",
    "no_handwritten_changes",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "mncs_version": {"const": "0.1"},
    "generator": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "generator_hash": {"$ref": "#/$defs/hash"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "command": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_hash": {"$ref": "#/$defs/hash"},
    "artifact_hash": {"$ref": "#/$defs/hash"},
    "evaluator": {"type": "string", "minLength": 1},
    "evaluator_version": {"type": "string", "minLength": 1},
    "evaluator_hash": {"$ref": "#/$defs/hash"},
    "no_handwritten_changes": {"type": "boolean"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
