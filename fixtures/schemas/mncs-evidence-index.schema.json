{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/0.2/mncs-evidence-index.schema.json",
  "title": "MNCS authoritative evidence graph index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mncs_version",
    "immutable",
    "unreferenced_evidence_policy",
    "records",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "mncs_version": {"const": "0.2"},
    "immutable": {"type": "boolean"},
    "unreferenced_evidence_policy": {"enum": ["warn", "reject"]},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256", "media_type"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {
            "enum": [
              "contract",
              "reference",
              "machine",
              "gate_result",
              "invariant",
              "performance",
              "provenance",
              "identity",
              "regeneration",
              "rollback",
              "witness",
              "fuzz",
              "mutation",
              "other"
            ]
          },
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/hash"},
          "media_type": {"type": "string", "minLength": 1},
          "contract_id": {"type": "string", "minLength": 1},
          "candidate_source_hash": {"$ref": "#/$defs/hash"},
          "description": {"type": "string"}
        }
      }
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
