{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/0.2/mncs-attestation-statement.schema.json",
  "title": "MNCS attestation statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "mncs_version", "schema_version", "subject", "contract_id", "component", "environment", "predicate_type", "predicate", "created_at", "extensions"],
  "properties": {
    "_type": {"const": "https://mncs.dev/attestation/v0.2/statement"},
    "mncs_version": {"const": "0.2"},
    "schema_version": {"const": "0.2"},
    "subject": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "mncs-subject-identity.schema.json"}},
    "contract_id": {"type": "string", "minLength": 1},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "identity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "environment": {"type": "string", "minLength": 1},
    "predicate_type": {
      "enum": [
        "https://mncs.dev/predicate/conformance-result/v0.2",
        "https://mncs.dev/predicate/gate-result/v0.2",
        "https://mncs.dev/predicate/evidence-index/v0.2",
        "https://mncs.dev/predicate/reproducible-package/v0.2",
        "https://mncs.dev/predicate/provider-result/v0.2",
        "https://mncs.dev/predicate/release-artifact/v0.2"
      ]
    },
    "predicate": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"}
    }
  }
}
