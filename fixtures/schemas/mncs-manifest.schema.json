{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/0.2/mncs-manifest.schema.json",
  "title": "MNCS evidence-derived conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "mncs_version",
    "claimed_level",
    "component",
    "contract",
    "reference",
    "machine",
    "generator",
    "environment",
    "acceptance_policy",
    "gate_results",
    "evidence_index",
    "limitations",
    "final_status",
    "extensions"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "0.2"},
    "mncs_version": {"const": "0.2"},
    "claimed_level": {"enum": ["MNCS-L1", "MNCS-L2", "MNCS-L3", "MNCS-L4", "MNCS-L5"]},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "contract_id", "criticality", "identity_hash"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "criticality": {"enum": ["low", "moderate", "high", "critical"]},
        "identity_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "contract": {"$ref": "#/$defs/fileReference"},
    "reference": {"$ref": "#/$defs/fileReference"},
    "machine": {
      "allOf": [
        {"$ref": "#/$defs/fileReference"},
        {
          "type": "object",
          "required": ["generated_marker"],
          "properties": {"generated_marker": {"const": "MNCS-GENERATED"}}
        }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "identity_evidence_id", "identity_hash"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "identity_evidence_id": {"$ref": "#/$defs/id"},
        "identity_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "identity_evidence_id", "description"],
      "properties": {
        "fingerprint": {"$ref": "#/$defs/hash"},
        "identity_evidence_id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "acceptance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conformance_level",
        "required_gates",
        "on_unknown",
        "conflicting_evidence",
        "objective",
        "regression_policy"
      ],
      "properties": {
        "conformance_level": {
          "enum": ["MNCS-L1", "MNCS-L2", "MNCS-L3", "MNCS-L4", "MNCS-L5"]
        },
        "required_gates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gateName"}
        },
        "on_unknown": {"enum": ["reject", "manual_review"]},
        "conflicting_evidence": {"const": "reject"},
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "unit",
            "direction",
            "threshold",
            "minimum_sample_count",
            "noise_policy",
            "declared_before_generation"
          ],
          "properties": {
            "metric": {"type": "string", "minLength": 1},
            "unit": {"type": "string", "minLength": 1},
            "direction": {"enum": ["higher_is_better", "lower_is_better"]},
            "threshold": {"type": "number"},
            "minimum_sample_count": {"type": "integer", "minimum": 2},
            "noise_policy": {"type": "string", "minLength": 1},
            "declared_before_generation": {"const": true}
          }
        },
        "regression_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_worst_case_ratio"],
          "properties": {
            "maximum_worst_case_ratio": {"type": "number", "minimum": 0}
          }
        },
        "mutation_required": {"type": "boolean"}
      }
    },
    "gate_results": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {"$ref": "#/$defs/gateName"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/id"}
      }
    },
    "evidence_index": {"$ref": "#/$defs/fileReference"},
    "fuzz_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "resource_bounds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["number", "integer", "string"]}
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "structural_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_invariants", "provider_assumptions", "bounded"],
      "properties": {
        "required_invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "provider_assumptions": {"type": "array", "items": {"type": "string"}},
        "bounded": {"const": true}
      }
    },
    "performance_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "provenance": {"$ref": "#/$defs/id"},
    "regeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "locked", "inputs_complete", "evidence_id"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "locked": {"const": true},
        "inputs_complete": {"const": true},
        "evidence_id": {"$ref": "#/$defs/id"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_available", "command", "evidence_id"],
      "properties": {
        "reference_available": {"const": true},
        "command": {"type": "string", "minLength": 1},
        "evidence_id": {"$ref": "#/$defs/id"}
      }
    },
    "immutable_evidence_index": {"const": true},
    "post_certification_identity_check": {"$ref": "#/$defs/id"},
    "comparison_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benefit", "complexity"],
      "properties": {
        "benefit": {"type": "object", "additionalProperties": {"type": "number"}},
        "complexity": {"type": "object", "additionalProperties": {"type": "number"}},
        "normalization": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "final_status": {"$ref": "#/$defs/status"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "allOf": [
    {
      "properties": {
        "acceptance_policy": {
          "properties": {
            "required_gates": {
              "allOf": [
                {"contains": {"const": "behavioral"}},
                {"contains": {"const": "compiler_matrix"}}
              ]
            }
          }
        },
        "gate_results": {"required": ["behavioral", "compiler_matrix"]}
      }
    },
    {
      "if": {
        "properties": {
          "claimed_level": {"enum": ["MNCS-L2", "MNCS-L3", "MNCS-L4", "MNCS-L5"]}
        },
        "required": ["claimed_level"]
      },
      "then": {
        "required": ["fuzz_evidence", "resource_bounds"],
        "properties": {
          "acceptance_policy": {
            "required": ["mutation_required"],
            "properties": {
              "required_gates": {
                "allOf": [
                  {"contains": {"const": "safety"}},
                  {"contains": {"const": "resource_bounds"}},
                  {"contains": {"const": "mutation"}}
                ]
              },
              "mutation_required": {"const": true}
            }
          },
          "gate_results": {"required": ["safety", "resource_bounds", "mutation"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "claimed_level": {"enum": ["MNCS-L3", "MNCS-L4", "MNCS-L5"]}
        },
        "required": ["claimed_level"]
      },
      "then": {
        "required": ["invariants", "structural_aggregate"],
        "properties": {
          "acceptance_policy": {
            "properties": {"required_gates": {"contains": {"const": "structural"}}}
          },
          "gate_results": {"required": ["structural"]}
        }
      }
    },
    {
      "if": {
        "properties": {"claimed_level": {"enum": ["MNCS-L4", "MNCS-L5"]}},
        "required": ["claimed_level"]
      },
      "then": {
        "required": ["performance_results"],
        "properties": {
          "acceptance_policy": {
            "properties": {
              "required_gates": {
                "allOf": [
                  {"contains": {"const": "measurement_valid"}},
                  {"contains": {"const": "benefit_threshold"}},
                  {"contains": {"const": "worst_regression"}}
                ]
              }
            }
          },
          "gate_results": {
            "required": ["measurement_valid", "benefit_threshold", "worst_regression"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"claimed_level": {"const": "MNCS-L5"}},
        "required": ["claimed_level"]
      },
      "then": {
        "required": [
          "provenance",
          "regeneration",
          "rollback",
          "immutable_evidence_index",
          "post_certification_identity_check"
        ],
        "properties": {
          "acceptance_policy": {
            "properties": {
              "required_gates": {
                "allOf": [
                  {"contains": {"const": "holdout"}},
                  {"contains": {"const": "regeneration"}},
                  {"contains": {"const": "provenance"}},
                  {"contains": {"const": "reproducibility"}},
                  {"contains": {"const": "post_certification_identity"}}
                ]
              }
            }
          },
          "gate_results": {
            "required": [
              "holdout",
              "regeneration",
              "provenance",
              "reproducibility",
              "post_certification_identity"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "gateName": {
      "oneOf": [
        {
          "enum": [
            "behavioral",
            "holdout",
            "safety",
            "compiler_matrix",
            "resource_bounds",
            "mutation",
            "structural",
            "measurement_valid",
            "benefit_threshold",
            "worst_regression",
            "reproducibility",
            "regeneration",
            "provenance",
            "post_certification_identity"
          ]
        },
        {"type": "string", "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$"}
      ]
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/hash"},
        "generated_marker": {"type": "string"}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
