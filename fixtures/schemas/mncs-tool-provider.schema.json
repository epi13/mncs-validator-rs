{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/0.2/mncs-tool-provider.schema.json",
  "title": "MNCS structural evidence provider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mncs_version",
    "provider_id",
    "name",
    "version",
    "identity_evidence_id",
    "methods",
    "statuses",
    "limitations",
    "offline_capable",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "mncs_version": {"const": "0.2"},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "identity_evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
      "contains": {"const": "UNKNOWN"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "offline_capable": {"type": "boolean"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
